# Diese Datei sagt Jekyll, welche Bibliotheken (Gems) verwendet werden.
# Für GitHub Pages bleibt das exakt so — nicht ändern, außer du weißt was du tust.

source "https://rubygems.org"

gem "github-pages", group: :jekyll_plugins

group :jekyll_plugins do
  gem "jekyll-feed"
  gem "jekyll-seo-tag"
  gem "jekyll-sitemap"
end

# Windows und JRuby brauchen tzinfo-data für Zeitzonen
platforms :mingw, :x64_mingw, :mswin, :jruby do
  gem "tzinfo", ">= 1", "< 3"
  gem "tzinfo-data"
end

gem "wdm", "~> 0.1.1", :platforms => [:mingw, :x64_mingw, :mswin]
gem "http_parser.rb", "~> 0.6.0", :platforms => [:jruby]
